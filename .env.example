# ---------------------------------------------------------------------------
# Dee Field Scheduler — environment configuration
# Copy to .env (root) and/or server/.env and fill in as needed.
# Everything works WITHOUT any keys (heuristic travel times + baked geocodes);
# add a Google Maps key for live traffic-aware drive times + real geocoding.
# ---------------------------------------------------------------------------

# Port the API + built client are served on
PORT=4000

# --- Database ---
# Leave DATABASE_URL EMPTY for local development: the app uses a zero-config
# SQLite file (DATABASE_FILE below). Set DATABASE_URL to a Postgres connection
# string (e.g. Supabase) for hosted/production use — the app switches engines
# automatically.
DATABASE_URL=
DATABASE_FILE=./data/scheduler.db

# When using Postgres, the schema this app lives in (keeps it isolated if the
# Postgres project is shared with other apps). Ignored for local SQLite.
DB_SCHEMA=field_scheduler

# --- Google Maps Platform (optional but recommended for production) ---
# Enable: Routes API, Distance Matrix API, Geocoding API for this key.
# When set, the server uses TRAFFIC_AWARE drive times with departure-time
# and real geocoding; otherwise it falls back to a built-in heuristic.
GOOGLE_MAPS_API_KEY=

# Client-side key for rendering Google map tiles (optional).
# Without it the client uses free OpenStreetMap tiles via Leaflet.
VITE_GOOGLE_MAPS_API_KEY=

# Average road speed assumptions for the heuristic travel-time engine
# (used only when GOOGLE_MAPS_API_KEY is not set)
HEURISTIC_CITY_KMH=38
HEURISTIC_HIGHWAY_KMH=78
